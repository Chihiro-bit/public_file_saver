<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.example.public_file_saver">
    <!-- Required to write to the public Downloads directory on Android 9 and
         below. maxSdkVersion="28" keeps it off Android 10+, where the plugin
         uses MediaStore and no permission is needed. Apps targeting Android
         6.0-9 must still request this permission at runtime. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
